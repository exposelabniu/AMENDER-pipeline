{
  "cve":               "CVE-2018-15139",
  "edb":               "50122",
  "module_type":       "exploit",
  "vuln_class":        "rce_upload",
  "name":              "OpenEMR prior to 5.0.1.4 Authenticated Remote Code Execution via File Upload",
  "description":       "Exploits an authenticated arbitrary file upload vulnerability in OpenEMR < 5.0.1.4 (CVE-2018-15139). The manage_site_files.php script allows authenticated administrators to upload files with arbitrary extensions to the images directory, enabling remote code execution by uploading a PHP webshell.",
  "author":            "AMENDER / Rezwanul Haque",
  "disclosure_date":   "2018-08-14",
  "references": [
    ["CVE",  "2018-15139"],
    ["EDB",  "50122"]
  ],
  "vuln_endpoint":     "/interface/super/manage_site_files.php",
  "vuln_method":       "POST",
  "upload_path":       "/sites/default/images/",
  "auth_endpoint":     "/interface/main/main_screen.php",
  "auth_params": {
    "new_login_session_management": "1",
    "authProvider": "Default",
    "authUser": "{{user}}",
    "clearPass": "{{password}}",
    "languageChoice": "1"
  },
  "confirm_pattern":   "AMENDER_RCE_CONFIRMED",
  "fail_markers":      ["login_screen.php?error=1", "Invalid username or password"],
  "default_username":  "admin",
  "default_password":  "",
  "default_filepath":  "/etc/passwd",
  "default_site":      "default",
  "target_uri":        "/",
  "login_params": {
    "new_login_session_management": "1",
    "authProvider": "Default",
    "languageChoice": "1"
  }
}
